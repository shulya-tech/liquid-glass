{
  "name": "@shulya/liquid-glass",
  "version": "1.1.4",
  "description": "High-performance, hardware-accelerated Liquid Glass optical UI engine with Screen-Space WebGL and empirical LUT 2D canvas fallback for React, Vue, Svelte, Angular, SolidJS, and Vanilla JS.",
  "author": "Shulya (https://shulya.tech)",
  "homepage": "https://liquid.shulya.tech",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shulya-tech/liquid-glass.git"
  },
  "bugs": {
    "url": "https://github.com/shulya-tech/liquid-glass/issues"
  },
  "keywords": [
    "liquid-glass",
    "glassmorphism",
    "optical-ui",
    "refraction",
    "apple-glass",
    "react",
    "vue",
    "svelte",
    "angular",
    "solidjs",
    "zero-webgl"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./types/index.d.ts",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs",
      "default": "./dist/index.mjs"
    },
    "./react": {
      "types": "./types/react.d.ts",
      "import": "./dist/react.mjs",
      "require": "./dist/react.cjs",
      "default": "./dist/react.mjs"
    },
    "./vue": {
      "types": "./types/vue.d.ts",
      "import": "./dist/vue.mjs",
      "require": "./dist/vue.cjs",
      "default": "./dist/vue.mjs"
    },
    "./svelte": {
      "types": "./types/svelte.d.ts",
      "import": "./dist/svelte.mjs",
      "require": "./dist/svelte.cjs",
      "default": "./dist/svelte.mjs"
    },
    "./angular": {
      "types": "./types/angular.d.ts",
      "import": "./dist/angular.mjs",
      "require": "./dist/angular.cjs",
      "default": "./dist/angular.mjs"
    },
    "./solid": {
      "types": "./types/solid.d.ts",
      "import": "./dist/solid.mjs",
      "require": "./dist/solid.cjs",
      "default": "./dist/solid.mjs"
    },
    "./tables": {
      "import": "./dist/tables.mjs",
      "require": "./dist/tables.cjs"
    }
  },
  "files": [
    "dist",
    "types",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node build.mjs",
    "build:example": "node build.mjs && cd example && npm install && npm run build",
    "example": "cd example && npm install && npm run dev",
    "prepublishOnly": "node build.mjs"
  },
  "peerDependencies": {
    "@angular/core": ">=14.0.0",
    "react": ">=17.0.0",
    "solid-js": ">=1.5.0",
    "svelte": ">=3.0.0",
    "vue": ">=3.0.0"
  },
  "peerDependenciesMeta": {
    "@angular/core": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "solid-js": {
      "optional": true
    },
    "svelte": {
      "optional": true
    },
    "vue": {
      "optional": true
    }
  },
  "sideEffects": false,
  "license": "MIT"
}
